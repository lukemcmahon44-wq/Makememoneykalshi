# ── BROKER ──────────────────────────────────────────────────────────────
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
PAPER_MODE=true

# ── DATA SOURCES ─────────────────────────────────────────────────────────
FRED_API_KEY=your_key_here
ALPHA_VANTAGE_KEY=your_key_here
REDDIT_CLIENT_ID=your_reddit_app_id
REDDIT_CLIENT_SECRET=your_reddit_app_secret
REDDIT_USER_AGENT=AlgoTrader/1.0

# ── ALERTS ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── ASSET UNIVERSE ───────────────────────────────────────────────────────
EQUITY_UNIVERSE=SPY,QQQ,AAPL,NVDA,TSLA,MSFT,AMZN,META,GOOGL,AMD
CRYPTO_UNIVERSE=BTCUSD,ETHUSD,SOLUSD
BINANCE_UNIVERSE=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT
PAIRS_UNIVERSE=SPY/QQQ,BTCUSD/ETHUSD

# ── RISK PARAMETERS ─────────────────────────────────────────────────────
MAX_DRAWDOWN_PCT=0.08
DAILY_LOSS_LIMIT_PCT=0.03
MAX_POSITION_PCT=0.15
MAX_TOTAL_LONG_PCT=0.80
KELLY_FRACTION=0.25
TARGET_ANNUAL_VOL=0.20
CVAR_LIMIT=0.02

# ── SIGNAL THRESHOLDS ────────────────────────────────────────────────────
SIGNAL_ENTRY_THRESHOLD=0.55
HIGH_CONVICTION_THRESHOLD=0.75
COOLDOWN_MINUTES=15

# ── SYSTEM ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DB_PATH=./trading_system/data/trading.db
MODEL_DIR=./trading_system/models/
DATA_CACHE_DIR=./trading_system/data/cache/
LOG_DIR=./trading_system/logs/
CLOSE_ON_SHUTDOWN=false

# Kill switch file location (touch this file to halt all trading)
KILL_SWITCH_FILE=/tmp/trading_kill_switch
