# ─────────────────────────────────────────────
#  Kalshi High-Probability Auto-Trader
#  Copy this file to .env and fill in real values.
#  NEVER commit your real .env file or private key.
# ─────────────────────────────────────────────

# ── Kalshi credentials ────────────────────────
# Your Kalshi API key ID (UUID-like string from the Kalshi web UI
# under Profile → API Keys → Create key).
KALSHI_API_KEY_ID=00000000-0000-0000-0000-000000000000

# Path to the RSA private key file you downloaded when creating the API key.
# Keep this file OUTSIDE the repo (or inside but covered by .gitignore).
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi_private_key.pem

# Optional: paste the PEM contents inline as a single string instead of a path.
# If both are set, KALSHI_PRIVATE_KEY_PATH wins.
# KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ── Environment & safety ──────────────────────
# "demo" or "production". KEEP "demo" UNTIL YOU HAVE FULLY TESTED.
ENVIRONMENT=demo
