# ─────────────────────────────────────────────
#  Kalshi Trading Bot — Environment Variables
#  Copy this file to .env and fill in all values.
#  NEVER commit your real .env file to git.
# ─────────────────────────────────────────────

# ── Bot Mode ──────────────────────────────────
# "btc"  → BTC Hourly Market Bot (Cowshed Robot)  ← recommended
# "edge" → General edge-finding bot (uses external providers)
BOT_MODE=btc

# ── Kalshi API ────────────────────────────────
# Your Kalshi API key (found at kalshi.com → Settings → API)
KALSHI_API_KEY=your_kalshi_api_key_here

# Kalshi API base URL (do not change unless using demo environment)
KALSHI_BASE_URL=https://trading-api.kalshi.com/trade-api/v2

# ── Telegram Alerts ───────────────────────────
# Bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your personal Telegram chat ID (send /start to @userinfobot to find it)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── OpenWeatherMap (Weather Provider) ─────────
# Free API key from https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ── The Odds API (Sports Provider) ────────────
# Free API key from https://the-odds-api.com (500 req/month free)
ODDS_API_KEY=your_odds_api_key_here

# ── NewsAPI (News Sentiment Provider) ─────────
# Free API key from https://newsapi.org (100 req/day free)
NEWS_API_KEY=your_newsapi_key_here

# ── Polling Provider ──────────────────────────
# URL to a JSON endpoint that returns polling data.
# Expected format: {"probability": 0.62} or array of objects with "probability" field.
# Example: a public FiveThirtyEight-style feed or your own endpoint.
POLLING_URL=https://your-polling-endpoint.com/data.json

# ── BTC Hourly Bot (Cowshed Robot) ───────────
# Kalshi series ticker for BTC hourly price markets
BTC_SERIES_TICKER=KXBTCU

# Only trade when YES or NO price is in this range (cents, 1–99)
# Default: 95–99¢ → the side must be 95%+ likely to win
BTC_BUY_MIN=95
BTC_BUY_MAX=99

# Target dollars to spend per trade (controls number of contracts)
# $10 at 97¢/contract = 10 contracts → risk $9.70, max win $0.30
BTC_TRADE_SIZE=10

# Skip a market if it expires within this many minutes (avoids last-minute entries)
BTC_MIN_MINS_TO_EXPIRY=5

# ── Shared Risk Controls ──────────────────────
# Halt all trading if account balance drops below this dollar amount
MIN_BALANCE_HALT=5

# Seconds between full market scans (300 = every 5 minutes)
SCAN_INTERVAL=300

# ── Edge Bot Settings (BOT_MODE=edge only) ────
MAX_POSITION_SIZE=2
MAX_OPEN_POSITIONS=5
EDGE_THRESHOLD=8

# ── Logging ───────────────────────────────────
LOG_FILE=bot.log
LOG_LEVEL=INFO
