# ── Kalshi Sniper environment ──────────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit your real .env or private key.

# ── Credentials (required) ─────────────────────────────────────────────────
# Create an API key in the Kalshi web app: Settings -> API Keys. You will be
# given a Key ID and you download/keep an RSA PRIVATE KEY (PEM). Upload the
# matching PUBLIC key to Kalshi; keep the private key local and secret.
KALSHI_API_KEY_ID=your-key-id-here
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
# Only if your PEM is passphrase-encrypted:
# KALSHI_PRIVATE_KEY_PASSWORD=

# ── Safety mode (both default ON if unset) ─────────────────────────────────
# DRY_RUN=true   -> logs intended trades, places NOTHING (default).
# Set to false ONLY after validating in demo. Any unrecognized value stays ON.
DRY_RUN=true
# USE_DEMO=true  -> uses the demo endpoint (default). false -> PRODUCTION.
USE_DEMO=true

# Optionally override the host explicitly (otherwise chosen by USE_DEMO):
# KALSHI_HOST=https://demo-api.kalshi.co
# KALSHI_HOST=https://api.elections.kalshi.com

# ── Operational (optional; sensible defaults live in config.py) ─────────────
# SCAN_INTERVAL_SECONDS=60
# LOG_DIR=logs
# DB_PATH=sniper_state.db

# Cancel our resting orders on shutdown (off by default; FOK means there should
# be none anyway):
# CANCEL_ON_EXIT=false

# Derive a missing yes_ask from the order book (off by default; can be read-heavy):
# DERIVE_ASK_FROM_ORDERBOOK=false
# MAX_ORDERBOOK_LOOKUPS_PER_CYCLE=50
